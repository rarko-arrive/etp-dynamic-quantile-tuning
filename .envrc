# (dotenv_if_exists needs direnv >= 2.31; this form works everywhere)
if [ -f .env ]; then
    dotenv .env
fi

export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-.venv}"

if [[ "$UV_PROJECT_ENVIRONMENT" == \~/* ]]; then
    export UV_PROJECT_ENVIRONMENT="$HOME/${UV_PROJECT_ENVIRONMENT:2}"
fi
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"

if [ -n "${DQT_DATA_DIR:-}" ]; then
    if [[ "$DQT_DATA_DIR" == \~/* ]]; then
        export DQT_DATA_DIR="$HOME/${DQT_DATA_DIR:2}"
    elif [[ "$DQT_DATA_DIR" == \~ ]]; then
        export DQT_DATA_DIR="$HOME"
    fi
fi
